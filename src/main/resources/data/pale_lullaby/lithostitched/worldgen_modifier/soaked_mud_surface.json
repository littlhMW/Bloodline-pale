{
  "type": "lithostitched:add_surface_rule",
  "priority": 1000,
  "levels": ["minecraft:overworld"],
  "injection_type": "prepend",
  "surface_rule": {
    "type": "minecraft:condition",
    "if_true": {
      "type": "minecraft:biome",
      "biome_is": ["pale_lullaby:crimson_garden"]
    },
    "then_run": {
      "type": "minecraft:sequence",
      "sequence": [
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 0,
            "surface_type": "floor",
            "add_surface_depth": false,
            "secondary_depth_range": 0
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": { "Name": "pale_lullaby:soaked_mud_grass" }
          }
        },
        {
          "type": "minecraft:condition",
          "if_true": {
            "type": "minecraft:stone_depth",
            "offset": 0,
            "surface_type": "floor",
            "add_surface_depth": true,
            "secondary_depth_range": 3
          },
          "then_run": {
            "type": "minecraft:block",
            "result_state": { "Name": "pale_lullaby:soaked_mud" }
          }
        }
      ]
    }
  }
}
